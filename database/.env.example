# ============================================================
# ENGRAVIA LABS — Database Configuration
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to: .env
#    (remove the .example part)
#
# 2. Replace the MONGODB_URI below with your actual
#    MongoDB Atlas connection string.
#
# Your connection string looks like this:
# mongodb+srv://engraviaadmin:YOURPASSWORD@engravia-cluster.xxxxx.mongodb.net/engravia-labs
#
# WHERE TO FIND IT:
# - Log in to cloud.mongodb.com
# - Click your cluster → Connect → Drivers
# - Copy the connection string
# - Replace <password> with your actual password
# - Add "engravia-labs" at the end (after the last /)
# ============================================================

MONGODB_URI=mongodb+srv://engraviaadmin:YOURPASSWORD@engravia-cluster.xxxxx.mongodb.net/engravia-labs
